module

public import Mathlib

/-!
# The Alon–Tarsi theorem and 3-choosability of planar bipartite graphs

An *orientation* of a simple graph `G` is a relation `D` such that every arc `D u v` is an edge of
`G`, every edge is oriented in at least one direction, and no edge in both
(`AlonTarsi.IsOrientation`). An *Eulerian subdigraph* of `D` is a set `F` of arcs with, at every
vertex, as many arcs of `F` leaving as entering; it is *even* or *odd* according to `#F`
(`AlonTarsi.eulerianCount D 0` and `AlonTarsi.eulerianCount D 1` count them).

* `OrientationColouring.alon_tarsi`: **Alon–Tarsi (1992).** If `G` has an orientation `D` whose
  numbers of even and odd Eulerian subdigraphs differ, then `G` has a proper colouring from any
  lists with `|L v| > outdeg_D v` for every vertex `v`.
* `OrientationColouring.choosable_three_of_isPlanar_bipartite`: **Alon–Tarsi (1992).** Every
  finite planar bipartite graph is 3-choosable.

Planarity is combinatorial: a graph is planar if it has a *plane map*, a rotation system of the
darts of genus zero (Euler defect `0`). This is the notion of the registered entry
PALOMAR-2026-10-15-000005; its definitions are reproduced below verbatim, with the same names as in
the library, together with the definitions of orientations and Eulerian counts, so that the
comparator checks them declaration by declaration.

The Mathlib definitions used in these statements are reproduced verbatim, with file and line at the
pinned Mathlib revision, in `MATHLIB_DEFINITIONS.md` at the root of this repository.
-/

/-! ## Definitions (verbatim from the library) -/

@[expose] public section

namespace LeanPool.K5MinorFreeChoosability

open Equiv Equiv.Perm

variable {α : Type*}

/-- The number of equivalence classes of `s`. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The number of cycles of `π`, counting fixed points as cycles of length one. -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

end LeanPool.K5MinorFreeChoosability

namespace LeanPool.K5MinorFreeChoosability

open Equiv Equiv.Perm

variable {D : Type*}

/-- The relation "in the same orbit of the group generated by `σ` and `α`". -/
def compSetoid (σ α : Perm D) : Setoid D where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = α a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `α` (connected components). -/
noncomputable def numComponents (σ α : Perm D) : ℕ := numClasses (compSetoid σ α)

/-- The Euler defect `|D| + 2 K - c(σ) - c(α) - c(σ α)` of the hypermap `(σ, α)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ α : Perm D) : ℤ :=
  (Nat.card D : ℤ) + 2 * (numComponents σ α : ℤ) - cycleCount σ - cycleCount α -
    cycleCount (σ * α)

end LeanPool.K5MinorFreeChoosability

namespace LeanPool.K5MinorFreeChoosability

open Equiv Equiv.Perm

variable {V : Type*} (G : SimpleGraph V)

/-- The edge involution `d ↦ d.symm` on the darts of `G`. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

/-- A rotation system: a cyclic order of the darts leaving each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- An embedded plane graph, represented by a genus-zero rotation system. -/
structure PlaneMap where
  /-- The rotation: the next dart counterclockwise around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` has a plane embedding. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

end LeanPool.K5MinorFreeChoosability

open Finset SimpleGraph

namespace AlonTarsi

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- `D` is an orientation of `G`: every arc is an edge, every edge is oriented, never both ways. -/
def IsOrientation (G : SimpleGraph V) (D : V → V → Prop) : Prop :=
  (∀ u v, D u v → G.Adj u v) ∧ (∀ u v, G.Adj u v → D u v ∨ D v u) ∧ ∀ u v, D u v → ¬ D v u

open Classical in
/-- The number of Eulerian subdigraphs of `D` (sets of arcs with in-degree equal to out-degree at
every vertex) whose number of arcs has parity `r`. -/
noncomputable def eulerianCount (D : V → V → Prop) (r : ℕ) : ℕ :=
  #{F ∈ (univ.filter fun p : V × V => D p.1 p.2).powerset |
    (∀ v, #{p ∈ F | p.1 = v} = #{p ∈ F | p.2 = v}) ∧ F.card % 2 = r}

end AlonTarsi

/-! ## Statements -/

namespace OrientationColouring

open AlonTarsi

variable {V : Type*} [Fintype V] [DecidableEq V]

open Classical in
/-- **The Alon–Tarsi theorem (1992).** If an orientation `D` of `G` has different numbers of even
and odd Eulerian subdigraphs, then `G` can be properly coloured from any lists `L` with
`|L v|` larger than the out-degree of `v` in `D`. -/
theorem alon_tarsi {Color : Type*} (G : SimpleGraph V) (D : V → V → Prop)
    (hD : IsOrientation G D) (hEO : eulerianCount D 0 ≠ eulerianCount D 1)
    (L : V → Finset Color) (hL : ∀ v, #{w | D v w} < (L v).card) :
    ∃ f : V → Color, (∀ v, f v ∈ L v) ∧ ∀ u v, G.Adj u v → f u ≠ f v := by
  sorry

omit [Fintype V] [DecidableEq V] in
/-- **Alon–Tarsi (1992).** Every finite planar bipartite graph is 3-choosable. -/
theorem choosable_three_of_isPlanar_bipartite [Finite V] {Color : Type*} (G : SimpleGraph V)
    (hP : LeanPool.K5MinorFreeChoosability.IsPlanar G) (hB : G.Colorable 2)
    (L : V → Finset Color) (hL : ∀ v, 3 ≤ (L v).card) :
    ∃ f : V → Color, (∀ v, f v ∈ L v) ∧ ∀ u v, G.Adj u v → f u ≠ f v := by
  sorry

end OrientationColouring
